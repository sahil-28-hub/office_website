# Copy to .env and fill in. The API validates all of this at boot and exits
# with a clear message rather than failing on the first request.
#
# "REQUIRED in production" below means: set it explicitly in Coolify's
# Environment Variables. Either the API refuses to boot without it (no default
# in src/config.ts), or the built-in default is insecure/public. Check this list
# against Coolify before every deploy — an app that shows "Running" on an old
# container can still fail its healthcheck on the next one.

# REQUIRED in production: NODE_ENV=production
NODE_ENV=development
PORT=4000

# REQUIRED in production (no default; the API exits at boot without it).
# Where the CMS runs. Comma-separated, because Vite falls back to 5174/5175
# when 5173 is taken and the browser would otherwise block every request.
# The CMS admin, and the website itself — blog comments are posted from a
# visitor's browser straight to this API, so the site's origin belongs here too.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# --- database ---------------------------------------------------------------
# REQUIRED in production: DB_HOST, DB_USER, DB_PASSWORD, DB_NAME.
# DB_NAME must match the database that actually exists on the server — on
# Coolify-provisioned MySQL it may be literally "default", not the name below.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Quote it. A '#' outside quotes starts a comment, which silently truncates
# the password and produces a confusing access-denied error.
DB_PASSWORD=root123
DB_NAME=techcadd_cms_ldh

# --- sessions ---------------------------------------------------------------
# REQUIRED in production. At least 16 characters, and unique per city — never
# reuse another city's value. Changing it signs everyone out.
COOKIE_SECRET=replace-with-a-long-random-string
SESSION_DAYS=7

# Cookie flags. Both are optional and default to COOKIE_SECURE=false /
# COOKIE_SAME_SITE=lax, which is correct for the same-origin nginx /api proxy.
# Set COOKIE_SECURE=true only if the CMS is served over HTTPS end to end.
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=lax

# REQUIRED in production: a second password that gates the enquiries (leads)
# module. It has a built-in fallback in src/config.ts, but that fallback is in
# the public source, so anyone who reads the repo knows it. Set a unique
# random value per city.
ENQUIRIES_LOCK_PASSWORD=replace-with-a-long-random-string

# Sign-in attempts per IP per 15 minutes. Unset means 10 in production and
# 200 in development, where the only thing it throttles is you.
# LOGIN_ATTEMPTS_PER_15_MIN=10

# --- uploads ----------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# --- email (optional) -------------------------------------------------------
# Without SMTP_HOST the CMS still runs and mail is logged to the console
# instead of sent, so password reset can be tested without a mail server.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=TechCADD CMS <no-reply@techcadd.com>

# Where to tell the website that content changed. Optional: without these the
# site picks changes up when its own cache expires instead of immediately.
# In production:
# SITE_REVALIDATE_URL=https://techcaddludhiana.com/api/revalidate
SITE_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=generate-a-long-random-string
