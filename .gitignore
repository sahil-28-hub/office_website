node_modules
.DS_Store
.claude

# Credentials. .env.example is the committed template; .env never is.
# The negation has to come after the .env.* line, or .env.example is
# swallowed by it and a fresh clone has no template to copy.
#
# The bare `.env` line was dropped in b18f5cc, and `.env.*` does not
# cover it — the glob needs something after the dot. The file was
# committed on the next push, DATABASE_URL and its password with it.
# Restored; see the note in DEPLOYMENT.md about rotating that password.
.env
.env.*
!.env.example

# Generated by `prisma generate` from prisma/schema.prisma, and
# regenerated on install. Committing it means a stale client survives
# a schema change.
server/generated
src/generated

# scaffolding `prisma init` drops in for other editors
.agents
.windsurf
skills-lock.json

# Build output. Committing dist/ is what produced the merge conflicts
# across ~40 hashed asset files: every build renames them, so two
# branches never touch the same paths and git cannot reconcile them.
# GitHub Pages builds it in CI now — see .github/workflows/deploy.yml.
dist

# Next.js build output and cache
.next
out

# TypeScript incremental build info
tsconfig.tsbuildinfo
