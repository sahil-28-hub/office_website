# ==================================================================
#  Copy this file to .env.local and fill in the real values.
#
#  .env.local is gitignored. Nothing in it should ever be committed,
#  and nothing in this file should ever be a real credential.
#
#  Next.js reads .env.local automatically. Variables prefixed with
#  NEXT_PUBLIC_ are exposed to the browser bundle; all others are
#  server-only.
# ==================================================================

# ---- MySQL -------------------------------------------------------
# The one place the database credentials live. Both the Prisma CLI
# (migrations) and the API route handlers read it.
#
#   mysql://USER:PASSWORD@HOST:PORT/DATABASE
#
# If the password contains @ : / ? # or %, percent-encode it.
DATABASE_URL="mysql://techcadd_app:CHANGE_ME@localhost:3306/techcadd"

# How many pooled connections the server holds. Keep it small on
# shared hosting, where the account has a low max_user_connections.
DB_POOL_SIZE=5

# ---- the browser bundle ------------------------------------------
# Next.js exposes NEXT_PUBLIC_ variables to the client bundle.
# These are inlined at BUILD time.
#
# Where the website reads CMS content from:
#   a deployed CMS   NEXT_PUBLIC_CMS_API_URL="https://cms.techcaddludhiana.com/api"
#   local CMS        NEXT_PUBLIC_CMS_API_URL="http://localhost:4000/api"
#   no CMS yet       NEXT_PUBLIC_CMS_API_URL="off"
#
# Left unset in development this defaults to http://localhost:4000/api,
# which is the PORT in cms-techcadd/backend/.env.example. Whatever you
# put here must also appear in that file's CORS_ORIGIN list, or the
# browser blocks the request and the site silently serves the bundled
# copy from src/data instead.
#
# Used by the server too, not only the browser: the route files fetch
# CMS content while rendering so it is in the HTML — see
# src/lib/cms.server.ts.
# NEXT_PUBLIC_CMS_API_URL="off"

# Where the forms post. Defaults to /api/leads, which is right when
# the API is served by the same Next.js app.
# NEXT_PUBLIC_LEADS_ENDPOINT="/api/leads"
# NEXT_PUBLIC_TEAM_ENDPOINT="/api/team-applications"

# Set to "mailto" for static deploy fallback.
# NEXT_PUBLIC_LEADS_TRANSPORT=mailto

# The inbox for fallback mailto and printed on forms.
NEXT_PUBLIC_ENQUIRY_INBOX="info@techcadd.com"

# ---- rate limiting -----------------------------------------------
# How many submissions one IP may send per window, per endpoint.
# LEADS_RATE_LIMIT=12
# TEAM_RATE_LIMIT=6
# RATE_LIMIT_WINDOW_MIN=15

# ---- CMS cache invalidation --------------------------------------
# The shared secret the CMS sends to POST /api/revalidate after an
# editor saves. It must be the SAME string as REVALIDATE_SECRET in
# cms-techcadd/backend/.env, and that file's SITE_REVALIDATE_URL must
# point at this site's /api/revalidate.
#
# Without this the route answers 503 and refuses every call: an
# unauthenticated cache-buster would let anyone force the site to
# rebuild every page on demand. Published changes then appear when the
# server cache expires on its own instead — five minutes, see
# REVALIDATE_SECONDS in src/lib/cms.server.ts.
#
# Check the wiring with:  curl http://localhost:3000/api/revalidate
REVALIDATE_SECRET="generate-a-long-random-string"

# Where the CMS admin runs. The preview route at /preview/<kind> only
# accepts a draft from these origins, and only replies to them — it
# renders unsaved content and reports back on it, so a wildcard would
# let any page that framed it drive the preview.
#
# Comma-separated because Vite falls back to 5174/5175 when 5173 is
# taken. In production this is the deployed admin's origin.
NEXT_PUBLIC_CMS_ADMIN_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost:5175"

# ---- This branch's own address -------------------------------------
# The origin every canonical URL, sitemap entry and schema id is built
# on. It MUST be this branch's domain — a value copied from another
# centre's deployment points every canonical at that centre's site.
# Build-time, like every NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SITE_URL="https://techcaddludhiana.com"

# ---- Ask Bhuvi -----------------------------------------------------
# Optional. Without a key the assistant answers from the CMS — AI
# Knowledge, the FAQs and the course catalogue — which is the normal
# configuration. With one, the same material is given to Claude and the
# CMS matcher is the fallback. Server-side only; never NEXT_PUBLIC_.
# ANTHROPIC_API_KEY=""
# BHUVI_MODEL="claude-opus-5-5"
